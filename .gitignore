/orig2.py

# Note: /docs/ is NOT excluded — it holds the superpowers plans/ and specs/
# directories that document design decisions for every shipped slice. The
# Sphinx build output is already covered by `docs/_build/` above; the
# historical /docs/_build/ rule predates the superpowers workflow.

screenshot*.png

# Local Redis password generated by start_app.vbs (audit P1-6)
redis-password.txt

# One-off diagnostic scratch scripts at the repo root. Diagnostic helpers
# belong in scripts/diagnostics/ (see scripts/diagnostics/test_sse_keepalive.py
# for the canonical SSE keepalive smoke test).
/.diag_*.py

# Token-efficiency restructure (C1): generated artifacts must never be tracked.
# (*.log, .coverage, .hypothesis/, .fallow/, .mavis/ already covered above.)
*_report.txt
*_report.json
/.test-artifacts/
/omniscribe_artifacts/

# CI JUnit XML output (Phase 5 test hardening). The workflow uploads
# the XML as an artifact; the local copy never belongs in the tree.
/reports/

# Debug scratch at the repo root. Phase 4 bundle-build attempts (anyio
# experiments) left a trail of one-off scripts and rendered page crops;
/.tmp_*.py
/temp_*.png
/scratch_*.png

# Bundle-build log output left at the repo root by repeated `make
# bundle-smoke` runs. The 5 files matching these patterns (~1.1 MB
# total, untracked, identical in shape) are noise; future runs
# accumulate the same way.
/build_*.log
/build_check*.log
/build_sprint*.log

# Sample-PDF fixtures are the canonical source-of-truth in
# ``tests/fixtures/pdfs/`` and are copied to this directory by
# ``make pre-build`` before wheel / PyInstaller builds, and by the
# autouse session fixture in ``tests/conftest.py`` for the test
# suite. The destination is therefore a build artifact, not source;
# the directory itself stays (with a ``.gitkeep``) so the cp
# target has somewhere to land. P5 reductive audit: this trims
# ~15.4 MB of binary duplication from the tracked tree.
/src/omniscribe/resources/sample_pdfs/*
!/src/omniscribe/resources/sample_pdfs/.gitkeep



# Local Trivy scan output (not for commit)
.trivy-out/

