# ===========================================================================
# OmniScribe — Environment Configuration Template
#
#   cp .env.example .env
#
# AGENTS.md is the authoritative reference for all settings. This file
# documents every environment variable the application reads, with safe
# local-development defaults. See AGENTS.md "Web Notes" for details.
# ===========================================================================

# ── LLM / VLM Endpoint ──────────────────────────────────────────────────────
# OpenAI-compatible VLM endpoint. Default targets LM Studio on localhost.
# For Docker, use http://host.docker.internal:1234/v1 to reach a host-side
# LM Studio. For Ollama, use http://localhost:11434/v1.
# Both LLM_* and canonical OMNISCRIBE_LLM_* alias forms are supported:
# OMNISCRIBE_LLM_API_BASE, OMNISCRIBE_LLM_API_KEY, OMNISCRIBE_LLM_MODEL.
LLM_API_BASE=http://localhost:1234/v1
# OMNISCRIBE_LLM_API_BASE=http://localhost:1234/v1

# API key for the VLM endpoint. LM Studio accepts any non-empty string.
# Alias: OMNISCRIBE_LLM_API_KEY
LLM_API_KEY=lm-studio
# OMNISCRIBE_LLM_API_KEY=lm-studio

# Model identifier loaded on the VLM server. Must match a model returned by
# GET /v1/models — the server pre-flights this before each /api/process call
# to guard against LM Studio's silent model fallback (issue #7).
# Alias: OMNISCRIBE_LLM_MODEL
LLM_MODEL=allenai/olmocr-2-7b
# OMNISCRIBE_LLM_MODEL=allenai/olmocr-2-7b

# ── Security ─────────────────────────────────────────────────────────────────
# Bearer auth token seed (OMNISCRIBE_AUTH_TOKEN).
# Note: Following the Cordis harness rebuild, ASGI bearer auth and rate-limiting
# middlewares are currently deferred capabilities (unauthenticated default).
# Generate a strong secret when configuring future auth:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# OMNISCRIBE_AUTH_TOKEN=change-me-to-a-strong-secret

# Comma-separated CORS allowlist for cross-origin browser requests.
# Empty/unset = same-origin only.
# OMNISCRIBE_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Max request body size in megabytes. Default 1024 (1 GB, was 10 GB until
# 2026-09-05), hard-capped at 102400 (100 GB). Raise for batch hosts that
# ingest very large image/PDF collections.
OMNISCRIBE_MAX_UPLOAD_MB=1024

# Number of pages per chunk when streaming long OCR jobs. Default 25.
# Smaller chunks = finer-grained progress; larger chunks = fewer round-trips.
# OMNISCRIBE_CHUNK_PAGES=25

# Hard cap on pages rasterized per run (after page-range selection).
# Documents over the cap fail fast with a 4xx instead of running for hours.
# Set to 0 to disable. Default 500.
# OMNISCRIBE_MAX_PAGES=500

# Per-client-IP HTTP request cap (sliding 60s window). Unset or 0 = disabled.
# (Scaffolding for deferred rate-limit plugin).
# OMNISCRIBE_RATE_LIMIT_PER_MIN=60

# Allow the server to connect to local/private IP addresses (LM Studio,
# Ollama, etc.). Code default in config.py is false for security; this
# template now mirrors the code default. Set to true ONLY when pointing
# at a local VLM endpoint on loopback (e.g. 127.0.0.1:1234) and disable
# immediately after.
ALLOW_SSRF_LOCAL=false

# ── VLM Resilience (retry + circuit breaker) ────────────────────────────────
# Every LLM call retries transient errors (429/5xx/connection resets) with
# exponential backoff. A per-request circuit breaker fails fast once the
# endpoint is deemed down so remaining pages don't each burn a full timeout.

# Max retry attempts for transient LLM errors (429, 5xx, connection resets).
OMNISCRIBE_LLM_MAX_RETRIES=2

# Base delay (seconds) for exponential backoff. Actual delay is
# min(base * 2^attempt, 8.0).
OMNISCRIBE_LLM_RETRY_BASE_DELAY=1.0

# Consecutive failures before the circuit breaker opens (fails fast with
# CircuitOpenError until the cooldown expires).
OMNISCRIBE_CB_FAILURE_THRESHOLD=5

# Seconds the circuit stays open before a half-open probe is allowed through.
OMNISCRIBE_CB_COOLDOWN=30

# ── OCR Pipeline ─────────────────────────────────────────────────────────────
# Number of pages processed concurrently.
OCR_CONCURRENCY=3

# DPI for PDF-to-image rasterization.
OCR_DPI=200

# Dense page handling: "auto" switches to per-box OCR when box count exceeds
# the dense threshold. Other values: "always", "never".
OCR_DENSE_MODE=auto

# Box count that triggers dense mode when OCR_DENSE_MODE=auto.
OCR_DENSE_THRESHOLD=60

# Maximum image dimension (pixels) for VLM input.
OCR_MAX_IMAGE_DIM=1024

# Re-align sparse OCR text to detection boxes using Dynamic Programming.
OCR_REFINE=true

# Pre-flight: verify the model is loaded on the VLM server before processing.
OCR_VERIFY_MODEL=true

# Pipeline mode: "hybrid" (Surya detect -> VLM OCR -> DP align -> refine)
# or "grounded" (single bbox-native VLM call, skips Surya and alignment).
OCR_PIPELINE_MODE=hybrid

# Self-correction: re-prompt the VLM on low-confidence pages.
OCR_SELF_CORRECTION=false

# Binarize images before OCR (useful for scanned documents).
OCR_BINARIZE=false

# Run both hybrid and grounded engines, then merge results.
OCR_DUAL_ENGINE=false

# Dictionary spellcheck post-processing: "none", "auto", or a language code.
OCR_SPELLCHECK=none

# Cross-page text alignment for multi-page documents.
OCR_CROSS_PAGE=false

# ── Quality Repair Loop ─────────────────────────────────────────────────────
# Automatic per-block quality retry: blocks whose estimated confidence is
# below the target are re-OCR'd (crop-scoped on the grounded path) up to
# max_retries times, accepting a retry only while confidence keeps improving.
# These env vars seed the runtime settings store; per-request form fields
# (quality_loop_enabled / quality_target / quality_max_retries) override them.
# Out-of-range seeds fall back to the defaults below (0.5 <= target <= 1.0,
# 0 <= max_retries <= 5).

# Master switch for the quality repair loop on /api/process. Default true.
OMNISCRIBE_QUALITY_LOOP=true

# Confidence target that triggers repair (0.5..1.0). Default 0.85.
OMNISCRIBE_QUALITY_TARGET=0.85

# Maximum repair retries per low-confidence block (0..5). Default 2.
OMNISCRIBE_QUALITY_MAX_RETRIES=2

# Whitespace recall (hybrid path): a pixel-statistics pass merges text-line
# boxes Surya missed into the detection output before dense selection, OCR,
# and alignment. Conservative filters trade recall for precision; the pass
# fails open per page and logs one INFO run summary per job. Disable values:
# 0/false/no/off/n/disabled (case-insensitive). Default on.
OMNISCRIBE_WHITESPACE_RECALL=true

# Text-layer recall (hybrid path): on digital PDFs, recovers text lines Surya
# missed straight from the embedded text layer — near-free, exact, immune to
# binarization pathologies. Complementary to the whitespace booster (merged
# after it, deduped against both). Scans and image inputs have no text layer,
# so the pass is a strict no-op there. Fails open per page and logs one INFO
# run summary per job. Disable values: 0/false/no/off/n/disabled
# (case-insensitive). Default on.
OMNISCRIBE_TEXT_LAYER_RECALL=true

# ── Page Preprocessing (hybrid path) ────────────────────────────────────────
# Master switch for the page preprocessor. Individual steps are toggled below.
OCR_PREPROCESS_PAGES=false

# Detect and correct page orientation.
OCR_ORIENTATION_DETECTION=false

# Deskew (straighten) pages.
OCR_DESKEW=false

# Denoise images.
OCR_DENOISE=false

# Normalize contrast.
OCR_NORMALIZE_CONTRAST=false

# Crop page margins / cleanup.
OCR_CROP_CLEANUP=false

# Route pages to different OCR strategies based on quality analysis.
OCR_QUALITY_ROUTING=false

# ── Async Translation (LangGraph on Harness JobQueue) ──────────────────────
# Async translation runs via the in-process single-worker JobQueue on the
# Cordis harness (Celery worker service is retired; Redis state backend is
# deferred). Requires the "async-translation" extra.
# Browser translation uses synchronous endpoints.

# Redis authentication password. REQUIRED: `cp .env.example .env && docker
# compose up` will refuse to start with an empty value (Compose's `:?`
# substitution names the variable in the error). Generate a real secret
# with one of:
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
#   openssl rand -hex 32
REDIS_PASSWORD=

# Redis URL (scaffolding for deferred Redis state backend).
# REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# The LanceDB lexicon store (glossary / translation terminology) lives in
# the artifact directory (lexicon.lance). Enable it with: uv sync --extra lexicon
